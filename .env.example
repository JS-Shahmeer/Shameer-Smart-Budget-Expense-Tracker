# Copy to .env.local for development, and add the same values in Vercel
# (Project Settings -> Environment Variables).
# Both values are in Supabase: Project Settings -> API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy "anon") key. Safe in the browser because RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Never add the service-role / secret key to this app. Nothing here needs it.
